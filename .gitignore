# ============================================================
# Library Management System - .gitignore
# ============================================================

# === Java / Spring Boot ===
backend/target/
*.class
*.jar
*.war
*.log

# === Node / React ===
frontend/node_modules/
frontend/dist/
frontend/.env

# === IDE Files ===
.idea/
*.iml
.vscode/
*.swp
*.swo

# === Environment / Secrets ===
.env
*.env.local

# === OS Files ===
.DS_Store
Thumbs.db

# === npm cache on D: ===
D:/npm-cache/
D:/temp/
